{
  "name": "a2ui-demo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "gen:types": "uv run --project ../backend python -m app.export_schema > src/api/wire.schema.json && json2ts -i src/api/wire.schema.json -o src/api/wire.ts --no-additionalProperties"
  },
  "dependencies": {
    "@a2ui/react": "0.11.1",
    "@a2ui/web_core": "0.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
