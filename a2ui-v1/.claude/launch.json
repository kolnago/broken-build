{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--project", "backend", "--directory", "backend", "uvicorn", "app.api:app", "--port", "8080", "--reload"],
