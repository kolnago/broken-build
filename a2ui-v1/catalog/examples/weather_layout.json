[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "weather",
      "catalogId": "https://a2ui-demo.local/catalogs/weather/v1/catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "weather",
      "components": [
        {"id": "root", "component": "Column", "children": ["cities", "card", "days"]},
        {"id": "cities", "component": "Row", "children": ["btn_prague", "btn_brno", "btn_london"]},
        {"id": "btn_prague", "component": "Button", "child": "lbl_prague",
         "action": {"event": {"name": "show_city", "context": {"city": "Prague"}}}},
        {"id": "lbl_prague", "component": "Text", "text": "Prague"},
        {"id": "btn_brno", "component": "Button", "child": "lbl_brno",
         "action": {"event": {"name": "show_city", "context": {"city": "Brno"}}}},
        {"id": "lbl_brno", "component": "Text", "text": "Brno"},
        {"id": "btn_london", "component": "Button", "child": "lbl_london",
         "action": {"event": {"name": "show_city", "context": {"city": "London"}}}},
        {"id": "lbl_london", "component": "Text", "text": "London"},
        {"id": "card", "component": "WeatherCard",
         "city": {"path": "/city"},
         "temperature": {"path": "/temperature_c"},
         "condition": {"path": "/condition"},
         "wind": {"path": "/wind_kmh"},
         "updatedAt": {"path": "/fetched_at"},
         "refresh": {"event": {"name": "refresh", "context": {"city": {"path": "/city"}}}}},
        {"id": "days", "component": "Column", "children": {"componentId": "day", "path": "/forecast"}},
        {"id": "day", "component": "Row", "justify": "spaceBetween", "children": ["day_date", "day_range"]},
        {"id": "day_date", "component": "Text", "text": {"path": "date"}},
        {"id": "day_range", "component": "Text",
         "text": {"call": "formatString", "args": {"value": "${min_c} / ${max_c} °C"}}}
      ]
    }
  }
]
